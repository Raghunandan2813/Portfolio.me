# Copy to `.env` for local development, and set the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# `.env*` is gitignored.

# --- Supabase Postgres -------------------------------------------------------
# IMPORTANT: use the TRANSACTION POOLER string (port 6543), not the direct
# connection (port 5432). Vercel serverless functions open a connection per
# invocation and will exhaust Postgres' connection limit without the pooler.
# Supabase dashboard -> Connect -> Transaction pooler.
# The app sets `prepare: false` because PgBouncer transaction mode cannot use
# prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct connection (port 5432), used ONLY by drizzle-kit for migrations.
# PgBouncer restricts the DDL that migrations need, so schema changes go direct.
# Supabase dashboard -> Connect -> Direct connection.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Site identity -----------------------------------------------------------
# Deployed origin, no trailing slash. Drives canonical URLs, the sitemap, and
# absolute Open Graph image URLs. A wrong value here breaks link previews.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- GitHub feeds ------------------------------------------------------------
# Two jobs:
#  1. Raises the API limit from 60/hour per shared IP to 5,000/hour.
#  2. Unlocks PRIVATE contributions in the activity heatmap. The REST events
#     endpoint only ever returns public activity; the GraphQL
#     viewer.contributionsCollection query returns the real calendar, but only
#     for the account that owns the token.
#
# For private contributions to appear, use a CLASSIC token with the `read:user`
# scope: https://github.com/settings/tokens
# A scopeless token still works, but the heatmap falls back to public-only.
GITHUB_TOKEN=

# --- Contact form ------------------------------------------------------------
# Brevo API key (SMTP & API -> API keys). Without it the form still stores
# messages in Postgres, but no email notification is sent.
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Where enquiry notifications are delivered.
CONTACT_EMAIL=raghu9555k@gmail.com
# Sender address, which Brevo requires you to verify under Senders & IP. A
# single mailbox is enough -- no custom domain needed. Leave blank to send from
# CONTACT_EMAIL. Replies always go to the visitor, not this address.
CONTACT_FROM=

# --- Search engine verification ---------------------------------------------
# Paste the token from the Search Console "HTML tag" verification method --
# only the content="..." value, not the whole tag.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Optional: Bing Webmaster Tools.
NEXT_PUBLIC_BING_VERIFICATION=
