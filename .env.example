# Copy to `.env` for local development, and set the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# `.env*` is gitignored.

# --- Supabase Postgres -------------------------------------------------------
# IMPORTANT: use the TRANSACTION POOLER string (port 6543), not the direct
# connection (port 5432). Vercel serverless functions open a connection per
# invocation and will exhaust Postgres' connection limit without the pooler.
# Supabase dashboard -> Connect -> Transaction pooler.
# The app sets `prepare: false` because PgBouncer transaction mode cannot use
# prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct connection (port 5432), used ONLY by drizzle-kit for migrations.
# PgBouncer restricts the DDL that migrations need, so schema changes go direct.
# Supabase dashboard -> Connect -> Direct connection.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Site identity -----------------------------------------------------------
# Deployed origin, no trailing slash. Drives canonical URLs, the sitemap, and
# absolute Open Graph image URLs. A wrong value here breaks link previews.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- GitHub feeds ------------------------------------------------------------
# Without this, GitHub allows only 60 requests/hour per IP, which serverless
# functions share. A fine-grained token with NO scopes (public read only)
# raises the limit to 5,000/hour.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Contact form ------------------------------------------------------------
# Resend API key. Without it the form still stores messages in Postgres, but no
# email notification is sent. https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiry notifications are delivered.
CONTACT_EMAIL=raghu9555k@gmail.com
# Verified sender. The Resend shared sender works for testing; use your own
# verified domain in production so mail does not land in spam.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
