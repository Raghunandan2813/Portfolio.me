# Copy to `.env` for local development. Set the same keys as secrets in your
# hosting dashboard for production. `.env*` is gitignored.

# --- Site identity -----------------------------------------------------------
# The deployed origin, no trailing slash. Drives canonical URLs, the sitemap,
# and absolute Open Graph image URLs. Wrong value = broken link previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- GitHub feeds ------------------------------------------------------------
# Without this, GitHub allows 60 requests/hour per IP, and a Cloudflare Worker
# shares egress IPs with many tenants, so the repo and activity feeds fall back
# to stale/empty data almost immediately. A fine-grained token with NO scopes
# (public read only) raises the limit to 5,000/hour.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Contact form ------------------------------------------------------------
# Resend API key. Without it the form still stores messages in D1, but no email
# notification is sent. https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiry notifications are delivered.
CONTACT_EMAIL=raghu9555k@gmail.com
# Verified sender. The Resend shared sender works for testing; use your own
# verified domain in production so mail does not land in spam.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
